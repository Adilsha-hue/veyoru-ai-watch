# Copy these into Windows PowerShell (or System Properties > Environment Variables).
# Only ONE free key is needed. Groq is recommended for the watch.

# Groq free cloud (recommended) - https://console.groq.com -> API Keys -> gsk_...
# $env:GROQ_API_KEY="gsk_paste_here"
# $env:LLM_PROVIDER="groq"
# $env:LLM_MODEL="llama-3.1-8b-instant"

# Gemini free cloud (alt) - https://aistudio.google.com -> Get API key
# $env:GEMINI_API_KEY="AIzaSy_paste_here"
# $env:LLM_PROVIDER="gemini"
# $env:LLM_MODEL="gemini-3.5-flash-lite"

# Ollama local free/offline (needs `ollama pull llama3.2:3b` + `ollama serve`)
# $env:LLM_PROVIDER="ollama"
# $env:OLLAMA_URL="http://localhost:11434"
# $env:LLM_MODEL="llama3.2:3b"

# OpenAI paid (existing behaviour)
# $env:OPENAI_API_KEY="sk-..."
# $env:LLM_PROVIDER="openai"
# $env:LLM_MODEL="gpt-5-mini"

# Hotspot LAN share (so phone/other device on laptop hotspot can reach gateway):
# py -3 server.py --port 8000 --host 0.0.0.0
# then use http://<laptop-wifi-ip>:8000/api/assistant as the LLM gateway field.
